# Backend server
PORT=4000

# MongoDB
DATABASE_URL=mongodb://127.0.0.1:27017/hostel_management

# Generate your own long, random JWT signing secret
JWT_URL=replace_with_a_long_random_secret

# Gmail SMTP (use a Google App Password, not your account password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password
